# Backstage media-server integration (services run locally on the HP ProDesk)
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=
SEERR_URL=http://127.0.0.1:5055
SEERR_API_KEY=
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
JELLYFIN_SERVER_ID=
MEDIA_SYNC_INTERVAL_SEC=60
MIN_FREE_GB=20
TEMPORARY_MAX_GB=500
RECOMMENDATION_DAILY_LIMIT=2
RECOMMENDATION_TIMEZONE=Europe/Paris
RECOMMENDATION_RECENT_DAYS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=256
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_AGE_HOURS=30

# Docker deployment
BACKSTAGE_PORT=8090
BACKSTAGE_DATA_DIR=./data/backstage

# Password recovery via Gmail SMTP (use a Google app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
BACKSTAGE_PUBLIC_URL=https://backstage.home.arpa
